{
  "description": "Adds the Obsidian note you are reading, and any text you selected, to your prompts.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/obsidian-context.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/obsidian-context.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
